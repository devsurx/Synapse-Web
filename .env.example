# Required — get yours at https://openrouter.ai
OPENROUTER_API_KEY=

# Optional — override the base model used by all features (default: openrouter/free).
# Keep a free model/router here to guarantee zero spend.
# OPENROUTER_MODEL=

# Optional — feature-specific model overrides
# OPENROUTER_MODEL_FEYNMAN=
# OPENROUTER_MODEL_ELI5=
# OPENROUTER_MODEL_FLASHCARDS=
# OPENROUTER_MODEL_PLANNER=

# Optional — Supabase for cloud-synced user data (stats).
# Leave empty to run locally (data stays in the browser).
# Create a project at https://supabase.com, run supabase/schema.sql,
# then paste the project URL and anon key below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server secret — lets /admin see every user (bypasses RLS). Never NEXT_PUBLIC_.
# Supabase dashboard → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Required — passkey for /admin (server secret, never NEXT_PUBLIC_).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_KEY=
